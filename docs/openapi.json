{
  "openapi": "3.0.3",
  "info": {
    "title": "Oficina — API da Fase 1",
    "version": "0.2.0",
    "description": "Cadastros administrativos. Valores monetários em centavos inteiros. Todos os endpoints de cadastro exigem JWT de administrador."
  },
  "servers": [
    {
      "url": "http://localhost:8000"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Customer": {
        "type": "object",
        "required": [
          "id",
          "name",
          "document",
          "document_type"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "document": {
            "type": "string",
            "description": "CPF ou CNPJ numérico ou alfanumérico, com dígitos verificadores válidos; pode ser enviado com máscara."
          },
          "document_type": {
            "type": "string",
            "enum": [
              "CPF",
              "CNPJ"
            ]
          },
          "email": {
            "type": "string",
            "nullable": true,
            "format": "email",
            "maxLength": 255
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "maxLength": 20
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Vehicle": {
        "type": "object",
        "required": [
          "id",
          "customer_id",
          "plate",
          "brand",
          "model",
          "year"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "customer_id": {
            "type": "integer",
            "minimum": 1
          },
          "plate": {
            "type": "string",
            "description": "Placa brasileira antiga ou Mercosul; normalizada em maiúsculas, sem hífen."
          },
          "brand": {
            "type": "string",
            "maxLength": 100
          },
          "model": {
            "type": "string",
            "maxLength": 100
          },
          "year": {
            "type": "integer",
            "description": "Entre 1886 e o ano corrente mais um."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Service": {
        "type": "object",
        "required": [
          "id",
          "name",
          "price_cents"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 5000
          },
          "price_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "current_page": {
            "type": "integer"
          },
          "last_page": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "CustomerInput": {
        "type": "object",
        "required": [
          "name",
          "document"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "document": {
            "type": "string",
            "description": "CPF ou CNPJ numérico ou alfanumérico, com dígitos verificadores válidos; pode ser enviado com máscara."
          },
          "email": {
            "type": "string",
            "nullable": true,
            "format": "email",
            "maxLength": 255
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "maxLength": 20
          }
        },
        "example": {
          "name": "Cliente de demonstração",
          "document": "529.982.247-25",
          "email": "cliente@example.test",
          "phone": "11999990000"
        }
      },
      "CustomerPatch": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "document": {
            "type": "string",
            "description": "CPF ou CNPJ numérico ou alfanumérico, com dígitos verificadores válidos; pode ser enviado com máscara."
          },
          "email": {
            "type": "string",
            "nullable": true,
            "format": "email",
            "maxLength": 255
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "maxLength": 20
          }
        }
      },
      "VehicleInput": {
        "type": "object",
        "required": [
          "customer_id",
          "plate",
          "brand",
          "model",
          "year"
        ],
        "properties": {
          "customer_id": {
            "type": "integer",
            "minimum": 1
          },
          "plate": {
            "type": "string",
            "description": "Placa brasileira antiga ou Mercosul; normalizada em maiúsculas, sem hífen."
          },
          "brand": {
            "type": "string",
            "maxLength": 100
          },
          "model": {
            "type": "string",
            "maxLength": 100
          },
          "year": {
            "type": "integer",
            "description": "Entre 1886 e o ano corrente mais um."
          }
        },
        "example": {
          "customer_id": 1,
          "plate": "BRA1A23",
          "brand": "Honda",
          "model": "Civic",
          "year": 2012
        }
      },
      "VehiclePatch": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "integer",
            "minimum": 1
          },
          "plate": {
            "type": "string",
            "description": "Placa brasileira antiga ou Mercosul; normalizada em maiúsculas, sem hífen."
          },
          "brand": {
            "type": "string",
            "maxLength": 100
          },
          "model": {
            "type": "string",
            "maxLength": 100
          },
          "year": {
            "type": "integer",
            "description": "Entre 1886 e o ano corrente mais um."
          }
        }
      },
      "ServiceInput": {
        "type": "object",
        "required": [
          "name",
          "price_cents"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 5000
          },
          "price_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
        },
        "example": {
          "name": "Troca de óleo e filtro",
          "description": "Mão de obra",
          "price_cents": 6000
        }
      },
      "ServicePatch": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 5000
          },
          "price_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/auth/token": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Obter JWT administrativo (validade de uma hora)",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "format": "password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token emitido",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "token_type": {
                      "type": "string",
                      "example": "Bearer"
                    },
                    "expires_in": {
                      "type": "integer",
                      "example": 3600
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Credenciais inválidas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Dados inválidos.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Limite de tentativas excedido: 10 por minuto e IP.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
